<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Cake.Twitter</id>
    <version>5.0.0</version>
    <authors>Gary Ewan Park</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/cake-contrib/Cake.Twitter/</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/cake-contrib/graphics/png/addin/cake-contrib-addin-medium.png</iconUrl>
    <description>Cake AddIn that extends Cake with ability to send messages to Twitter.</description>
    <releaseNotes>https://github.com/cake-contrib/Cake.Twitter/releases/tag/5.0.0</releaseNotes>
    <copyright>Copyright © 2016-2025 — Cake Contributions</copyright>
    <tags>Cake Script Build Twitter cake-addin addin cake-build</tags>
    <repository type="git" url="https://github.com/cake-contrib/Cake.Twitter.git" branch="refs/heads/tags/5.0.0" commit="6f16c7fa6ae926838134dc3604286f0bea04a822" />
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="Cake.Testing" version="4.0.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="Cake.Testing" version="4.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>